@model TechStore.ViewModels.HomeIndexViewModel

<div class="home-container">

    <section class="home-hero">

        <div class="hero-decoration">

            <span class="hero-orbit orbit-one" aria-hidden="true"></span>
            <span class="hero-orbit orbit-two" aria-hidden="true"></span>

            <div class="hero-carousel"
                 data-hero-carousel
                 aria-label="Öne çıkan görseller">

                <button type="button"
                        class="hero-carousel-arrow hero-carousel-prev"
                        data-carousel-prev
                        aria-label="Önceki görsel">

                    <i class="fa-solid fa-chevron-left"></i>

                </button>

                <div class="hero-carousel-viewport">

                    <div class="hero-carousel-track">

                        <div class="hero-carousel-slide active">
                            <img src="~/uploads/img/banner-3.png"
                                 alt="Dystopia öne çıkan görsel 1" />
                        </div>

                        <div class="hero-carousel-slide">
                            <img src="~/uploads/img/34b5bf180145769.6505ae7623131.jpg"
                                 alt="Dystopia öne çıkan görsel 2" />
                        </div>

                        <div class="hero-carousel-slide">
                            <img src="~/uploads/img/1581342925_Logitech_Renewal_SoMe.jpg"
                                 alt="Dystopia öne çıkan görsel 3" />
                        </div>

                        <div class="hero-carousel-slide">
                            <img src="~/uploads/img/GTA6GTAOnlineBanner.jpg"
                                 alt="Dystopia öne çıkan görsel 4" />
                        </div>

                    </div>

                </div>

                <button type="button"
                        class="hero-carousel-arrow hero-carousel-next"
                        data-carousel-next
                        aria-label="Sonraki görsel">

                    <i class="fa-solid fa-chevron-right"></i>

                </button>

                <div class="hero-carousel-dots" aria-label="Görsel seçimi">

                    <button type="button"
                            class="hero-carousel-dot active"
                            data-carousel-dot="0"
                            aria-label="1. görsel"></button>

                    <button type="button"
                            class="hero-carousel-dot"
                            data-carousel-dot="1"
                            aria-label="2. görsel"></button>

                    <button type="button"
                            class="hero-carousel-dot"
                            data-carousel-dot="2"
                            aria-label="3. görsel"></button>

                    <button type="button"
                            class="hero-carousel-dot"
                            data-carousel-dot="3"
                            aria-label="4. görsel"></button>

                </div>

            </div>

        </div>

    </section>

    <section class="campaign-strip" aria-label="Kampanya bilgisi">

        <div>
            <span class="campaign-icon">✦</span>

            <p>

                <strong>Haftanın fırsatları</strong>

                <span>Seçili ürünleri kaçırma.</span>

            </p>

        </div>

        <div class="countdown" data-countdown aria-label="Kampanya bitiş sayacı">

            <span>
                <b data-days>00</b>
                <small>GÜN</small>

            </span><span>

                <b data-hours>00</b>
                <small>SAAT</small>

            </span><span>

                <b data-minutes>00</b>
                <small>DK</small>

            </span><span>

                <b data-seconds>00</b>
                <small>SN</small>

            </span>

        </div>

        <a asp-action="Index">Fırsatları Gör →</a>

    </section>

    @if (Model.Categories.Any())
    {
        <section class="category-discovery">

            <div class="section-heading">
                <div>

                    <span class="section-eyebrow">KATEGORİLER</span>

                    <h2>Aradığını kolayca bul</h2>

                </div>
                <a asp-action="Index" class="view-all-link">Tümünü Gör →</a>
            </div>

            <div class="category-grid">

                @foreach (var category in Model.Categories.Take(6))
                {
                    <a asp-action="Index" asp-route-categoryId="@category.Id" class="category-card">

                        <span class="category-card-icon">⌁</span>
                        <span class="category-card-name">@category.Name</span>
                        <span class="category-card-link">İncele →</span>

                    </a>
                }

            </div>

        </section>
    }

    <section class="home-products" id="featured-products">

        <div class="section-heading">

            <div>

                <span class="section-eyebrow">@(!string.IsNullOrWhiteSpace(Model.Search) || Model.SelectedCategoryId.HasValue ? "ARAMA SONUÇLARI" : "ÖNE ÇIKANLAR")</span>

                <h2>@(!string.IsNullOrWhiteSpace(Model.Search) || Model.SelectedCategoryId.HasValue ? "Sana uygun ürünler" : "Yeni gelen teknoloji")</h2>

            </div>

            <a asp-action="Index" class="view-all-link">Tüm Ürünler →</a>

        </div>

        @if (Model.Products.Any())
        {
            <div class="products-grid">

                @foreach (var product in Model.Products)
                {
                    <article class="product-card">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="button"
                                    class="wishlist-heart-btn @(Model.WishlistProductIds.Contains(product.Id) ? "active" : "")"
                                    data-product-id="@product.Id"
                                    data-in-wishlist="@(Model.WishlistProductIds.Contains(product.Id) ? "true" : "false")"
                                    aria-label="Favorilere ekle/çıkar">
                                <i class="fa-solid fa-heart"></i>
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="wishlist-heart-btn" aria-label="Favorilemek için giriş yap">
                                <i class="fa-solid fa-heart"></i>
                            </a>
                        }

                        <a asp-action="Details" asp-route-id="@product.Id" class="product-card-link">

                            <div class="product-image">

                                @{
                                    var mainImage = product.Images
                                    .FirstOrDefault(x => x.IsMain)?.ImageUrl
                                    ?? product.Images.FirstOrDefault()?.ImageUrl;
                                }

                                @if (!string.IsNullOrEmpty(mainImage))
                                {
                                    <img src="@mainImage" alt="@product.Name" />
                                }
                                else
                                {
                                    <div class="no-product-image">
                                        <span> ⚡ </span>
                                        <small>RESİM YOK</small>
                                    </div>
                                }

                                <span class="product-category">@product.Category.Name</span>

                                @if (product.Stock > 0)
                                {
                                    <span class="product-stock">Stokta</span>
                                }

                            </div>

                            <div class="product-content">

                                <span class="product-brand">@product.Brand</span>
                                <h3 class="product-name">@product.Name</h3>

                                <div class="product-card-rating">
                                    <span class="stars">
                                        @{
                                            var avgRating = product.Reviews.Any() ? product.Reviews.Average(r => r.Rating) : 0;
                                        }
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(avgRating))
                                            {
                                                <span class="star filled">★</span>
                                            }
                                            else
                                            {
                                                <span class="star">★</span>
                                            }
                                        }
                                    </span>

                                    @if (product.Reviews.Any())
                                    {
                                        <span class="product-card-rating-count">(@product.Reviews.Count)</span>
                                    }
                                </div>

                            </div>

                        </a>

                        <div class="product-content product-content-bottom">

                            <div class="product-bottom">

                                <strong class="product-price">@product.Price.ToString("N2") ₺</strong>

                                @if (product.Stock > 0)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post"><input type="hidden" name="productId" value="@product.Id" /><input type="hidden" name="quantity" value="1" /><button type="submit" class="product-cart-button" title="Sepete ekle">🛒</button></form>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>

            <div class="pagination-info">
                @(Model.TotalCount == 0 ? "0" : ((Model.CurrentPage - 1) * Model.PageSize + 1).ToString())–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) / @Model.TotalCount ürün
            </div>

            var startPage = Math.Max(1, Model.CurrentPage - 2);
            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

            @if (Model.TotalPages > 1)
            {
                <div class="pagination">

                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-fragment="featured-products"
                           class="pagination-btn">
                            <i class="fa-solid fa-chevron-left"></i>
                            Önceki
                        </a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">
                            <i class="fa-solid fa-chevron-left"></i>
                            Önceki
                        </span>
                    }

                    @if (startPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-page="1"
                           asp-fragment="featured-products"
                           class="page-number">1</a>

                        if (startPage > 2)
                        {
                            <span class="page-ellipsis">…</span>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-page="@i"
                           asp-fragment="featured-products"
                           class="page-number @(i == Model.CurrentPage ? "active" : "")">
                            @i
                        </a>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        if (endPage < Model.TotalPages - 1)
                        {
                            <span class="page-ellipsis">…</span>
                        }

                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-page="@Model.TotalPages"
                           asp-fragment="featured-products"
                           class="page-number">@Model.TotalPages</a>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.SelectedCategoryId"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-fragment="featured-products"
                           class="pagination-btn">
                            Sonraki
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">
                            Sonraki
                            <i class="fa-solid fa-chevron-right"></i>
                        </span>
                    }

                </div>
            }

        }
        else
        {
            <div class="empty-products">

                <span>⚡</span>

                <h3>Aradığınız ürün bulunamadı.</h3>

                <p>Farklı bir arama veya kategori deneyin.</p>

                <a asp-action="Index" class="empty-products-link">
                    Tüm ürünleri göster
                </a>

            </div>
        }

    </section>

    <section class="trust-section" aria-label="TechStore avantajları">

        <article>
            <span>🔒</span>
            <div>
                <h3>Güvenli alışveriş</h3>
                <p>Ödeme bilgilerin özenle işlenir.</p>
            </div>
        </article>

        <article>
            <span>⚡</span>
            <div>
                <h3>Hızlı süreç</h3>
                <p>Siparişini kolayca takip et.</p>
            </div>
        </article>

        <article>
            <span>↺</span>
            <div>
                <h3>Kolay destek</h3>
                <p>İhtiyacın olduğunda yanındayız.</p>
            </div>
        </article>

        <article>
            <span>✦</span>
            <div>
                <h3>Seçili ürünler</h3>
                <p>Teknolojiyi yakından takip et.</p>
            </div>
        </article>

    </section>

    <section class="club-section">
        <div>
            <span class="section-eyebrow">DYSTOPİA KULÜBÜ</span>
            <h2>Yeni fırsatları ilk sen gör.</h2>
            <p>Hesabını oluştur, siparişlerini takip et ve destek ekibimize doğrudan ulaş.</p>
        </div>

        <a asp-controller="Account" asp-action="Register" class="hero-button">
            Hesap Oluştur
            <span>→</span>
        </a>

    </section>

</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
