@model TechStore.ViewModels.PagedResultViewModel<TechStore.Models.AppUser>
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-user-page">

    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert admin-alert-danger">@TempData["Error"]</div>
    }

    <div class="page-header">
        <span class="page-eyebrow">KULLANICI YÖNETİMİ</span>
        <h2>Kullanıcılar</h2>
    </div>

    <form asp-action="Index" method="get" class="user-search-bar">

        <div class="filter-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" placeholder="Kullanıcı Ara..." value="@Model.Search" />
        </div>

        <button type="submit" class="filter-btn">
            Ara
        </button>

    </form>

    <div class="user-table-card">

        <div class="table-wrapper">

            <table class="user-table">

                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Kullanıcı Adı</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.UserName</td>
                            <td class="action-column">

                                <div class="action-buttons">

                                    <a asp-action="Detail" asp-route-id="@user.Id" class="user-detail-link">
                                        Detay
                                    </a>

                                    <button type="button" class="user-delete-btn" data-bs-toggle="modal" data-bs-target="#deleteModal-@user.Id">
                                        Sil
                                    </button>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    @foreach (var user in Model.Items)
    {
        <div class="modal fade" id="deleteModal-@user.Id" tabindex="-1" aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content admin-modal-content">

                    <div class="modal-header admin-modal-header">
                        <h5 class="modal-title">Kullanıcı Sil</h5>
                        <button type="button" class="admin-modal-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>

                    <div class="modal-body admin-modal-body">
                        <p><strong>@user.Email</strong> kullanıcısını silmek istediğinizden emin misiniz?</p>
                        <p class="modal-warning-text">Bu işlem geri alınamaz.</p>
                    </div>

                    <div class="modal-footer admin-modal-footer">

                        <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">
                            İptal
                        </button>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn-modal-delete">
                                Kullanıcıyı Sil
                            </button>
                        </form>

                    </div>

                </div>

            </div>

        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="admin-pagination">

            <ul>

                @if (Model.HasPreviousPage)
                {
                    <li>
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search">
                            <i class="fa-solid fa-chevron-left"></i>
                            Önceki
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@(i == Model.CurrentPage ? "active" : "")">
                        <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search">
                            @i
                        </a>
                    </li>
                }

                @if (Model.HasNextPage)
                {
                    <li>
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search">
                            Sonraki
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                }

            </ul>

        </nav>
    }

</div>
