@model TechStore.ViewModels.AdminOrderDetailViewModel
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-order-detail-page">

    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert admin-alert-danger">@TempData["Error"]</div>
    }

    <div class="page-header">
        <span class="page-eyebrow">SİPARİŞ YÖNETİMİ</span>
        <h2>Sipariş Detayı #@Model.OrderId</h2>

        <div class="order-meta">
            <span>Durum: <strong>@Model.Status</strong></span>
            <span>Tarih: <strong>@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</strong></span>
        </div>
    </div>

    <!-- CUSTOMER INFO -->
    <div class="detail-card">

        <div class="detail-card-header">
            <h3><i class="fa-solid fa-user"></i> Müşteri Bilgileri</h3>
        </div>

        <div class="customer-info-grid">

            <div class="info-item">
                <span>Sipariş No</span>
                <strong>#@Model.OrderId</strong>
            </div>

            <div class="info-item">
                <span>Müşteri</span>
                <strong>@Model.FullName</strong>
            </div>

            <div class="info-item">
                <span>Telefon</span>
                <strong>@Model.Phone</strong>
            </div>

            <div class="info-item">
                <span>Şehir</span>
                <strong>@Model.City</strong>
            </div>

            <div class="info-item">
                <span>İlçe</span>
                <strong>@Model.District</strong>
            </div>

            <div class="info-item info-item-wide">
                <span>Adres</span>
                <strong>@Model.Address</strong>
            </div>

        </div>

    </div>

    <!-- PRODUCTS -->
    <div class="detail-card">

        <div class="detail-card-header">
            <h3><i class="fa-solid fa-boxes-stacked"></i> Sipariş Ürünleri</h3>
        </div>

        <div class="table-wrapper">

            <table class="detail-products-table">

                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Adet</th>
                        <th>Birim Fiyat</th>
                        <th>Tutar</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td><span class="quantity-badge">@item.Quantity</span></td>
                            <td>@item.UnitPrice.ToString("N2") ₺</td>
                            <td class="line-total">@item.TotalPrice.ToString("N2") ₺</td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr class="grand-total-row">
                        <td colspan="3">Genel Toplam</td>
                        <td class="line-total">@Model.TotalPrice.ToString("N2") ₺</td>
                    </tr>
                </tfoot>

            </table>

        </div>

    </div>

    <!-- STATUS UPDATE -->
    <div class="detail-card">

        <div class="detail-card-header">
            <h3><i class="fa-solid fa-truck"></i> Sipariş Durumu</h3>
        </div>

        <form asp-action="UpdateStatus" method="post" class="status-form">

            <input type="hidden" name="id" value="@Model.OrderId" />

            <select name="status" class="status-select">

                @foreach (var statusOption in Model.StatusOptions)
                {
                    <option value="@statusOption" selected="@(Model.Status == statusOption)">
                        @statusOption
                    </option>
                }

            </select>

            <button type="submit" class="btn-update-status">
                <i class="fa-solid fa-check"></i>
                Durumu Güncelle
            </button>

        </form>

    </div>

</div>