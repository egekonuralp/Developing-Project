<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TechStore Admin</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <!-- DASHBOARD -->
    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard")
    {
        <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    }

    <!-- PRODUCT -->
    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
    {
        <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Create")
    {
        <link rel="stylesheet" href="~/css/prdct-create.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Edit")
    {
        <link rel="stylesheet" href="~/css/prdct-edit.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Delete")
    {
        <link rel="stylesheet" href="~/css/prdct-delete.css" asp-append-version="true" />
    }

    <!-- CATEGORY -->
    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
    {
        <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Create")
    {
        <link rel="stylesheet" href="~/css/ctgry-create.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Edit")
    {
        <link rel="stylesheet" href="~/css/ctgry-edit.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Delete")
    {
        <link rel="stylesheet" href="~/css/ctgry-delete.css" asp-append-version="true" />
    }

    <!-- ADMİN ORDER -->
    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOrder" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
    {
        <link rel="stylesheet" href="~/css/admin-order.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOrder" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Detail")
    {
        <link rel="stylesheet" href="~/css/admin-order-detail.css" asp-append-version="true" />
    }

    <!-- ADMİN SUPPORT -->
    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminSupport" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
    {
        <link rel="stylesheet" href="~/css/admin-sup.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminSupport" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Detail")
    {
        <link rel="stylesheet" href="~/css/admin-sup-detail.css" asp-append-version="true" />
    }

    <!-- ADMİN USER -->
    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminUser" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Index")
    {
        <link rel="stylesheet" href="~/css/admin-user.css" asp-append-version="true" />
    }

    @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminUser" &&
        ViewContext.RouteData.Values["Action"]?.ToString() == "Detail")
    {
        <link rel="stylesheet" href="~/css/admin-user-detail.css" asp-append-version="true" />
    }



</head>

@{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<body>

    <div class="wrapper">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="logo">

                <i class="fa-solid fa-store"></i>

                <div>

                    <h3>TechStore</h3>

                    <span>Admin Panel</span>

                </div>

            </div>

            <nav class="sidebar-menu">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="@(currentController == "Dashboard" ? "active" : "")">

                    <i class="fa-solid fa-chart-line"></i>

                    <span>Dashboard</span>

                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="@(currentController == "Product" ? "active" : "")">

                    <i class="fa-solid fa-box"></i>

                    <span>Products</span>

                </a>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="@(currentController == "Category" ? "active" : "")">

                    <i class="fa-solid fa-layer-group"></i>

                    <span>Categories</span>

                </a>

                <a asp-controller="AdminOrder" 
                   asp-action="Index" 
                   class="@(currentController == "AdminOrder" ? "active" : "")">

                    <i class="fa-solid fa-cart-shopping"></i>

                    <span>Orders</span>

                </a> 

                <a asp-controller="AdminUser"
                   asp-action="Index"
                   class="@(currentController == "AdminUser" ? "active" : "")">

                    <i class="fa-solid fa-users"></i>

                    <span>Users</span>

                </a>

                <a asp-controller="AdminSupport"
                   asp-action="Index"
                   class="@(currentController == "AdminSupport" ? "active" : "")">

                    <i class="fa-solid fa-headset"></i>

                    <span>Support</span>

                </a>

            </nav>

            <div class="sidebar-footer">

                <a asp-area="Identity"
                   asp-page="/Account/Logout">

                    <i class="fa-solid fa-right-from-bracket"></i>

                    <span>Logout</span>

                </a>

            </div>

        </aside>

        <!-- Main Content -->
        <div class="main-content">

            <!-- Topbar -->
            <header class="topbar @(currentController == "Dashboard" ? "dashboard-topbar" : "")">

                <div class="topbar-left">

                    <h4>@ViewData["Title"]</h4>

                </div>

                <div class="topbar-right">

                    <button class="icon-btn">

                        <i class="fa-solid fa-bell"></i>

                    </button>

                    <div class="admin-profile">

                        <i class="fa-solid fa-user-shield"></i>

                        <span>Admin</span>

                    </div>

                </div>

            </header>

            <!-- Page Content -->
            <main class="content @(currentController == "Dashboard" ? "dashboard-content" : "")">

                @RenderBody()

            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>