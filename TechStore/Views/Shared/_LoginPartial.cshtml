@using TechStore.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);

    <div class="account-wrapper">

        <!-- ACCOUNT TOGGLE -->
        <a href="#" class="account-toggle" id="accountDropdown">

            <span class="account-icon">
                👤
            </span>

            <span class="account-name">
                @(currentUser?.FirstName ?? User.Identity?.Name)
            </span>

            <span class="account-arrow">
                ▼
            </span>

        </a>

        <!-- ACCOUNT DROPDOWN -->
        <ul class="account-dropdown" aria-labelledby="accountDropdown">

            <!-- PROFİLE -->
            <li>

                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">

                    <i class="fa-solid fa-user"></i>
                    
                    <span>
                        Kullanıcı Bilgilerim
                    </span>

                </a>

            </li>

            <!-- ORDERS -->
            <li>

                <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">

                    <i class="fa-solid fa-box"></i>

                    <span>
                        Siparişlerim
                    </span>

                </a>

            </li>

            <!-- SUPPORT -->
            <li>

                <a class="dropdown-item" asp-controller="Support" asp-action="MyTickets">

                    <i class="fa-solid fa-headset"></i>

                    <span>
                        Destek Taleplerim
                    </span>

                </a>

            </li>

            <!-- CART -->
            <li>

                <a class="dropdown-item" asp-controller="Cart" asp-action="Index">

                    <i class="fa-solid fa-cart-shopping"></i>

                    <span>
                        Sepetim
                    </span>

                </a>

            </li>

            <!-- ADMİN -->
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <hr class="dropdown-divider"/>
                </li>

                <li>

                    <a class="dropdown-item admin-link" asp-controller="Dashboard" asp-action="Index">

                        <i class="fa-solid fa-gauge-high"></i>

                        <span>
                            Admin Panel
                        </span>

                    </a>

                </li>
            }

            <!-- LOGOUT SEPARATOR -->
            <li>
                <hr class="dropdown-divider"/>
            </li>

            <!-- LOGOUT -->
            <li>

                <form asp-controller="Account" asp-action="Logout" method="post">

                    <button type="submit" class="dropdown-item logout-item">

                        <i class="fa-solid fa-right-from-bracket"></i>

                        <span>
                            Çıkış Yap
                        </span>

                    </button>

                </form>

            </li>

        </ul>

    </div>
}
else
{
    <!-- GUEST ACTİONS -->
    <div class="guest-actions">

        <a asp-controller="Account" asp-action="Login" class="login-link">
            Giriş Yap
        </a>

        <a asp-controller="Account" asp-action="Register" class="register-button">
            Kayıt Ol
        </a>

    </div>
}