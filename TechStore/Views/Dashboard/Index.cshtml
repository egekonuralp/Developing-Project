@model TechStore.ViewModels.DashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <!-- =====================================================
         DASHBOARD HERO
         ===================================================== -->

    <section class="dashboard-hero">

        <div class="dashboard-hero-grid">

            <div class="dashboard-hero-content">

                <div class="dashboard-hero-kicker">

                    <span class="status-dot"></span>

                    ADMIN CONTROL CENTER

                </div>

                <h1>
                    Welcome back.
                    <span>TechStore</span>
                </h1>

                <p>
                    Store operations, inventory, customers and orders
                    can be monitored from a single control center.
                </p>

                <div class="dashboard-hero-meta">

                    <div class="hero-meta-item">

                        <i class="fa-regular fa-calendar"></i>

                        <span>
                            @DateTime.Now.ToString("dd.MM.yyyy")
                        </span>

                    </div>

                    <div class="hero-meta-divider"></div>

                    <div class="hero-meta-item">

                        <i class="fa-solid fa-shield-halved"></i>

                        <span>
                            ADMIN ACCESS
                        </span>

                    </div>

                </div>

            </div>


            <div class="dashboard-hero-panel">

                <div class="hero-panel-header">

                    <span>
                        SYSTEM STATUS
                    </span>

                    <span class="system-status">
                        <i class="fa-solid fa-circle"></i>
                        ONLINE
                    </span>

                </div>

                <div class="hero-panel-content">

                    <div class="hero-panel-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <div>

                        <strong>
                            Store Overview
                        </strong>

                        <span>
                            Operational data is available.
                        </span>

                    </div>

                </div>

                <div class="hero-panel-line"></div>

                <div class="hero-panel-footer">

                    <span>
                        CONTROL
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         QUICK ACTIONS
         ===================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">

            <div>

                <span class="section-kicker">
                    QUICK ACCESS
                </span>

                <h2>
                    Quick Actions
                </h2>

            </div>

            <span class="section-count">
                04 ACTIONS
            </span>

        </div>


        <div class="quick-actions">

            <!-- ADD PRODUCT -->

            <a asp-controller="Product"
               asp-action="Create"
               class="action-card">

                <div class="action-card-top">

                    <div class="action-icon">
                        <i class="fa-solid fa-plus"></i>
                    </div>

                    <i class="fa-solid fa-arrow-up-right-from-square action-open-icon"></i>

                </div>

                <div class="action-content">

                    <span class="action-index">
                        01
                    </span>

                    <strong>
                        Add Product
                    </strong>

                    <p>
                        Create and publish a new product.
                    </p>

                </div>

                <div class="action-footer">

                    <span>
                        PRODUCT
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </div>

            </a>


            <!-- ADD CATEGORY -->

            <a asp-controller="Category"
               asp-action="Create"
               class="action-card">

                <div class="action-card-top">

                    <div class="action-icon">
                        <i class="fa-solid fa-folder-plus"></i>
                    </div>

                    <i class="fa-solid fa-arrow-up-right-from-square action-open-icon"></i>

                </div>

                <div class="action-content">

                    <span class="action-index">
                        02
                    </span>

                    <strong>
                        Add Category
                    </strong>

                    <p>
                        Organize products into a new category.
                    </p>

                </div>

                <div class="action-footer">

                    <span>
                        CATEGORY
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </div>

            </a>


            <!-- PRODUCTS -->

            <a asp-controller="Product"
               asp-action="Index"
               class="action-card">

                <div class="action-card-top">

                    <div class="action-icon">
                        <i class="fa-solid fa-box"></i>
                    </div>

                    <i class="fa-solid fa-arrow-up-right-from-square action-open-icon"></i>

                </div>

                <div class="action-content">

                    <span class="action-index">
                        03
                    </span>

                    <strong>
                        View Products
                    </strong>

                    <p>
                        Review and manage your inventory.
                    </p>

                </div>

                <div class="action-footer">

                    <span>
                        INVENTORY
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </div>

            </a>


            <!-- CATEGORIES -->

            <a asp-controller="Category"
               asp-action="Index"
               class="action-card">

                <div class="action-card-top">

                    <div class="action-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>

                    <i class="fa-solid fa-arrow-up-right-from-square action-open-icon"></i>

                </div>

                <div class="action-content">

                    <span class="action-index">
                        04
                    </span>

                    <strong>
                        View Categories
                    </strong>

                    <p>
                        Manage and organize product groups.
                    </p>

                </div>

                <div class="action-footer">

                    <span>
                        ORGANIZATION
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </div>

            </a>

        </div>

    </section>


    <!-- =====================================================
         STORE STATISTICS
         ===================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">

            <div>

                <span class="section-kicker">
                    STORE OVERVIEW
                </span>

                <h2>
                    Store Statistics
                </h2>

            </div>

            <span class="section-count">
                LIVE DATA
            </span>

        </div>


        <div class="stats-grid">

            <!-- PRODUCTS -->

            <article class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-box"></i>
                    </div>

                    <span class="stat-index">
                        01
                    </span>

                </div>

                <div class="stat-info">

                    <span class="stat-label">
                        TOTAL PRODUCTS
                    </span>

                    <strong>
                        @Model.ProductCount
                    </strong>

                    <small>
                        Products currently tracked
                    </small>

                </div>

                <div class="stat-line"></div>

            </article>


            <!-- CATEGORIES -->

            <article class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>

                    <span class="stat-index">
                        02
                    </span>

                </div>

                <div class="stat-info">

                    <span class="stat-label">
                        CATEGORIES
                    </span>

                    <strong>
                        @Model.CategoryCount
                    </strong>

                    <small>
                        Product groups available
                    </small>

                </div>

                <div class="stat-line"></div>

            </article>


            <!-- USERS -->

            <article class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <span class="stat-index">
                        03
                    </span>

                </div>

                <div class="stat-info">

                    <span class="stat-label">
                        REGISTERED USERS
                    </span>

                    <strong>
                        @Model.UserCount
                    </strong>

                    <small>
                        Customer accounts
                    </small>

                </div>

                <div class="stat-line"></div>

            </article>


            <!-- ORDERS -->

            <article class="stat-card">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </div>

                    <span class="stat-index">
                        04
                    </span>

                </div>

                <div class="stat-info">

                    <span class="stat-label">
                        TOTAL ORDERS
                    </span>

                    <strong>
                        @Model.OrderCount
                    </strong>

                    <small>
                        Orders placed
                    </small>

                </div>

                <div class="stat-line"></div>

            </article>


            <!-- REVENUE -->

            <article class="stat-card stat-card-revenue">

                <div class="stat-top">

                    <div class="stat-icon">
                        <i class="fa-solid fa-coins"></i>
                    </div>

                    <span class="stat-index">
                        05
                    </span>

                </div>

                <div class="stat-info">

                    <span class="stat-label">
                        TOTAL REVENUE
                    </span>

                    <strong>
                        ₺@Model.Revenue.ToString("N2")
                    </strong>

                    <small>
                        Recorded store revenue
                    </small>

                </div>

                <div class="stat-line"></div>

            </article>

        </div>

    </section>


    <!-- =====================================================
         PRODUCT DISTRIBUTION
         ===================================================== -->

    <section class="dashboard-section">

        <div class="dashboard-card chart-card">

            <div class="card-header">

                <div class="card-header-content">

                    <span class="section-kicker">
                        INVENTORY ANALYTICS
                    </span>

                    <h2>
                        Product Distribution
                    </h2>

                    <p>
                        Product count grouped by category.
                    </p>

                </div>

                <div class="card-header-side">

                    <span class="analytics-badge">
                        <i class="fa-solid fa-chart-column"></i>
                        ANALYTICS
                    </span>

                </div>

            </div>


            <div class="chart-container">

                <canvas id="productChart"></canvas>

            </div>

        </div>

    </section>


    <!-- =====================================================
         RECENT DATA
         ===================================================== -->

    <section class="dashboard-section">

        <div class="dashboard-grid">


            <!-- =================================================
                 RECENT PRODUCTS
                 ================================================= -->

            <div class="dashboard-card recent-products-card">

                <div class="card-header">

                    <div class="card-header-content">

                        <span class="section-kicker">
                            INVENTORY
                        </span>

                        <h2>
                            Recent Products
                        </h2>

                    </div>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="card-link">

                        View All

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>


                @if (Model.RecentProducts.Any())
                {
                    <div class="table-wrapper">

                        <table class="table-custom">

                            <thead>

                                <tr>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Action</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var product in Model.RecentProducts)
                                {
                                    var mainImage =
                                    product.Images.FirstOrDefault(x => x.IsMain)
                                    ?? product.Images.FirstOrDefault();

                                    <tr>

                                        <!-- PRODUCT -->

                                        <td>

                                            <div class="product-info">

                                                <div class="product-image-wrapper">

                                                    @if (mainImage != null)
                                                    {
                                                        <img src="@mainImage.ImageUrl"
                                                             class="table-image"
                                                             alt="@product.Name" />
                                                    }
                                                    else
                                                    {
                                                        <div class="table-image-placeholder">
                                                            <i class="fa-solid fa-image"></i>
                                                        </div>
                                                    }

                                                </div>

                                                <div class="product-details">

                                                    <strong>
                                                        @product.Name
                                                    </strong>

                                                    <small>
                                                        @product.Brand
                                                    </small>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- CATEGORY -->

                                        <td>

                                            <span class="category-badge">

                                                <i class="fa-solid fa-layer-group"></i>

                                                @product.Category.Name

                                            </span>

                                        </td>


                                        <!-- PRICE -->

                                        <td>

                                            <strong class="product-price">
                                                ₺@product.Price.ToString("N2")
                                            </strong>

                                        </td>


                                        <!-- ACTION -->

                                        <td>

                                            <a asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="table-action"
                                               title="Edit product">

                                                <i class="fa-solid fa-pen"></i>

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="dashboard-empty">

                        <div class="empty-icon">
                            <i class="fa-solid fa-box-open"></i>
                        </div>

                        <span class="empty-kicker">
                            INVENTORY EMPTY
                        </span>

                        <strong>
                            No products yet.
                        </strong>

                        <p>
                            Products will appear here once you create them.
                        </p>

                        <a asp-controller="Product"
                           asp-action="Create"
                           class="empty-action">

                            Add Product

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>
                }

            </div>


            <!-- =================================================
                 RECENT CATEGORIES
                 ================================================= -->

            <div class="dashboard-card recent-categories-card">

                <div class="card-header">

                    <div class="card-header-content">

                        <span class="section-kicker">
                            ORGANIZATION
                        </span>

                        <h2>
                            Recent Categories
                        </h2>

                    </div>

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="card-link">

                        View All

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>


                @if (Model.RecentCategories.Any())
                {
                    <div class="category-list">

                        @foreach (var category in Model.RecentCategories)
                        {
                            <div class="category-item">

                                <div class="category-icon">

                                    <i class="fa-solid fa-layer-group"></i>

                                </div>

                                <div class="category-info">

                                    <strong>
                                        @category.Name
                                    </strong>

                                    <span>
                                        Product category
                                    </span>

                                </div>

                                <i class="fa-solid fa-chevron-right category-arrow"></i>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="dashboard-empty">

                        <div class="empty-icon">
                            <i class="fa-solid fa-folder-open"></i>
                        </div>

                        <span class="empty-kicker">
                            ORGANIZATION EMPTY
                        </span>

                        <strong>
                            No categories yet.
                        </strong>

                        <p>
                            Categories will appear here once created.
                        </p>

                        <a asp-controller="Category"
                           asp-action="Create"
                           class="empty-action">

                            Add Category

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>
                }

            </div>

        </div>

    </section>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            fetch('/Dashboard/ProductDistribution')

                .then(response => {

                    if (!response.ok) {
                        throw new Error(
                            "Product distribution could not be loaded."
                        );
                    }

                    return response.json();

                })

                .then(data => {

                    const labels = data.map(
                        x => x.categoryName
                    );

                    const values = data.map(
                        x => x.productCount
                    );

                    const canvas =
                        document.getElementById("productChart");

                    if (!canvas) {
                        return;
                    }

                    new Chart(canvas, {

                        type: "bar",

                        data: {

                            labels: labels,

                            datasets: [

                                {
                                    label: "Products",

                                    data: values,

                                    backgroundColor: [
                                        "rgba(255, 255, 255, 0.82)",
                                        "rgba(205, 210, 214, 0.82)",
                                        "rgba(170, 176, 181, 0.82)",
                                        "rgba(135, 142, 148, 0.82)",
                                        "rgba(105, 112, 118, 0.82)",
                                        "rgba(78, 84, 90, 0.82)"
                                    ],

                                    borderColor: [
                                        "rgba(255, 255, 255, 0.92)",
                                        "rgba(205, 210, 214, 0.92)",
                                        "rgba(170, 176, 181, 0.92)",
                                        "rgba(135, 142, 148, 0.92)",
                                        "rgba(105, 112, 118, 0.92)",
                                        "rgba(78, 84, 90, 0.92)"
                                    ],

                                    borderWidth: 1,

                                    borderRadius: 5,

                                    borderSkipped: false,

                                    maxBarThickness: 46
                                }

                            ]

                        },

                        options: {

                            responsive: true,

                            maintainAspectRatio: false,

                            interaction: {
                                intersect: false,
                                mode: "index"
                            },

                            plugins: {

                                legend: {
                                    display: false
                                },

                                tooltip: {

                                    backgroundColor: "#17191c",

                                    titleColor: "#f0f2f3",

                                    bodyColor: "#b7bdc2",

                                    borderColor:
                                        "rgba(255, 255, 255, 0.12)",

                                    borderWidth: 1,

                                    padding: 12,

                                    displayColors: false,

                                    callbacks: {

                                        label: function (context) {

                                            return " "
                                                + context.parsed.y
                                                + " products";

                                        }

                                    }

                                }

                            },

                            scales: {

                                x: {

                                    border: {
                                        display: false
                                    },

                                    ticks: {

                                        color: "#858c92",

                                        font: {
                                            size: 11,
                                            weight: "600"
                                        },

                                        padding: 8

                                    },

                                    grid: {
                                        display: false
                                    }

                                },

                                y: {

                                    beginAtZero: true,

                                    border: {
                                        display: false
                                    },

                                    ticks: {

                                        stepSize: 1,

                                        color: "#6f767c",

                                        font: {
                                            size: 11
                                        },

                                        padding: 8

                                    },

                                    grid: {

                                        color:
                                            "rgba(255, 255, 255, 0.055)",

                                        drawTicks: false

                                    }

                                }

                            }

                        }

                    });

                })

                .catch(error => {

                    console.error(
                        "Chart error:",
                        error
                    );

                });

        });

    </script>
}