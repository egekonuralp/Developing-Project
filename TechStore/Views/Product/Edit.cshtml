@model TechStore.ViewModels.ProductEditViewModel

@{
    ViewData["Title"] = "Ürün Düzenle";
    Layout = "_AdminLayout";
}

<div class="product-form-page">

    <!-- PAGE HEADER -->
    <div class="product-form-header">

        <div class="product-form-heading">

            <span class="product-form-eyebrow">
                PRODUCT MANAGEMENT
            </span>

            <h2>Ürün Düzenle</h2>

            <p>
                Ürün bilgilerini, fiyatını, stok durumunu ve görselini güncelleyin.
            </p>

        </div>

        <a asp-action="Index" class="form-back-button">

            <i class="fa-solid fa-arrow-left"></i>

            <span>Ürünlere Dön</span>

        </a>

    </div>

    <!-- VALIDATION SUMMARY -->
    <div asp-validation-summary="ModelOnly" class="form-validation-summary">
    </div>

    <!-- FORM -->
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="product-form">

        <input type="hidden" asp-for="Id" />

        <div class="product-form-layout">

            <!-- LEFT COLUMN -->
            <div class="product-form-main">

                <!-- BASIC INFORMATION -->
                <div class="form-card">

                    <div class="form-card-header">

                        <div class="form-card-title">

                            <div class="form-card-icon icon-brown">
                                <i class="fa-solid fa-box"></i>
                            </div>

                            <div>

                                <span>PRODUCT INFORMATION</span>

                                <h3>Ürün Bilgileri</h3>

                            </div>

                        </div>

                    </div>

                    <div class="form-card-body">

                        <!-- NAME -->
                        <div class="form-group">

                            <label asp-for="Name" class="form-label-custom">
                                Ürün Adı
                            </label>

                            <div class="input-wrapper">

                                <i class="fa-solid fa-tag input-icon"></i>

                                <input asp-for="Name" class="form-input-custom" placeholder="Örn. Logitech G Pro X Superlight" />

                            </div>

                            <span asp-validation-for="Name" class="field-validation"></span>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="form-group">

                            <label asp-for="Description" class="form-label-custom">
                                Açıklama
                            </label>

                            <textarea asp-for="Description" class="form-textarea-custom" rows="5" placeholder="Ürün hakkında açıklama girin..."></textarea>

                            <span asp-validation-for="Description" class="field-validation"></span>

                        </div>

                        <!-- PRICE / STOCK -->
                        <div class="form-row">

                            <div class="form-group">

                                <label asp-for="Price" class="form-label-custom">
                                    Fiyat
                                </label>

                                <div class="input-wrapper">

                                    <i class="fa-solid fa-turkish-lira-sign input-icon"></i>

                                    <input asp-for="Price" class="form-input-custom" type="number" step="0.01" min="0" placeholder="0.00" />

                                </div>

                                <span asp-validation-for="Price" class="field-validation"></span>

                            </div>

                            <div class="form-group">

                                <label asp-for="Stock" class="form-label-custom">
                                    Stok
                                </label>

                                <div class="input-wrapper">

                                    <i class="fa-solid fa-cubes-stacked input-icon"></i>

                                    <input asp-for="Stock" class="form-input-custom" type="number" min="0" placeholder="0" />

                                </div>

                                <span asp-validation-for="Stock" class="field-validation"></span>

                            </div>

                        </div>

                        <!-- BRAND / CATEGORY -->
                        <div class="form-row">

                            <div class="form-group">

                                <label asp-for="Brand" class="form-label-custom">
                                    Marka
                                </label>

                                <div class="input-wrapper">

                                    <i class="fa-solid fa-copyright input-icon"></i>

                                    <input asp-for="Brand" class="form-input-custom" placeholder="Örn. Logitech" />

                                </div>

                                <span asp-validation-for="Brand" class="field-validation"></span>

                            </div>

                            <div class="form-group">

                                <label asp-for="CategoryId" class="form-label-custom">
                                    Kategori
                                </label>

                                <div class="select-wrapper">

                                    <i class="fa-solid fa-layer-group select-icon"></i>

                                    <select asp-for="CategoryId" class="form-select-custom">

                                        <option value="">
                                            Kategori Seçiniz
                                        </option>

                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.Id">
                                                @category.Name
                                            </option>
                                        }

                                    </select>

                                    <i class="fa-solid fa-chevron-down select-arrow"></i>

                                </div>

                                <span asp-validation-for="CategoryId" class="field-validation"></span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- IMAGE -->
                <div class="form-card">

                    <div class="form-card-header">

                        <div class="form-card-title">

                            <div class="form-card-icon icon-gold">
                                <i class="fa-solid fa-image"></i>
                            </div>

                            <div>

                                <span>PRODUCT IMAGE</span>

                                <h3>Ürün Görseli</h3>

                            </div>

                        </div>

                    </div>

                    <div class="form-card-body">

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="current-image-section">

                                <div class="current-image-title">

                                    <div>

                                        <strong>Mevcut Görsel</strong>

                                        <span>
                                            Ürünün şu anda kullanılan görseli
                                        </span>

                                    </div>

                                    <span class="current-image-badge">
                                        Mevcut
                                    </span>

                                </div>

                                <div class="current-image-preview">
                                    <img src="@Model.ImageUrl" alt="@Model.Name" />
                                </div>

                            </div>
                        }

                        <div class="upload-section">

                            <div class="upload-header">

                                <div>

                                    <strong>Yeni Görsel</strong>

                                    <span>
                                        Mevcut görseli değiştirmek için yeni bir dosya seçin.
                                    </span>

                                </div>

                            </div>

                            <label class="upload-box">

                                <i class="fa-solid fa-cloud-arrow-up"></i>

                                <strong>
                                    Yeni ürün görseli seçin
                                </strong>

                                <span>
                                    JPG, JPEG, PNG veya WEBP
                                </span>

                                <input asp-for="ImageFile" type="file" accept="image/*" />

                            </label>

                            <small class="upload-note">

                                <i class="fa-solid fa-circle-info"></i>

                                Yeni bir resim seçmezseniz mevcut resim korunacaktır.

                            </small>

                            <span asp-validation-for="ImageFile" class="field-validation"></span>

                        </div>

                    </div>

                </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="product-form-sidebar">

                <!-- EDIT SUMMARY -->
                <div class="form-card summary-card">

                    <div class="form-card-header">

                        <div class="form-card-title">

                            <div class="form-card-icon icon-olive">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </div>

                            <div>

                                <span>EDIT SUMMARY</span>

                                <h3>Güncelleme</h3>

                            </div>

                        </div>

                    </div>

                    <div class="summary-body">

                        <div class="summary-row">

                            <span>Ürün ID</span>

                            <strong>
                                #@Model.Id
                            </strong>

                        </div>

                        <div class="summary-row">

                            <span>Ürün</span>

                            <strong class="summary-product-name">
                                @(string.IsNullOrWhiteSpace(Model.Name)
                                    ? "Yeni Ürün"
                                    : Model.Name)
                            </strong>

                        </div>

                        <div class="summary-row">

                            <span>Fiyat</span>

                            <strong class="summary-price">
                                ₺@Model.Price.ToString("N2")
                            </strong>

                        </div>

                    </div>

                </div>

                <!-- ACTIONS -->
                <div class="form-card form-actions-card">

                    <div class="form-actions">

                        <button type="submit" class="btn-save-product">

                            <i class="fa-solid fa-check"></i>

                            <span>Değişiklikleri Kaydet</span>

                        </button>

                        <a asp-action="Index" class="btn-cancel-product">

                            <i class="fa-solid fa-xmark"></i>

                            <span>Vazgeç</span>

                        </a>

                    </div>

                </div>

                <!-- INFO -->
                <div class="form-info-box">

                    <div class="info-icon">
                        <i class="fa-solid fa-circle-info"></i>
                    </div>

                    <div>

                        <strong>Bilgi</strong>

                        <p>
                            Üründe yaptığınız değişiklikler kaydedildikten
                            sonra mağazada güncel haliyle görüntülenecektir.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const fileInput = document.getElementById("ImageFile");
            const uploadBox = document.querySelector(".upload-box");

            if (!fileInput || !uploadBox) {
                return;
            }

            fileInput.addEventListener("change", function () {

                if (this.files && this.files.length > 0) {

                    const fileName = this.files[0].name;

                    const strong = uploadBox.querySelector("strong");

                    if (strong) {
                        strong.textContent = fileName;
                    }

                }

            });

        });

    </script>
}