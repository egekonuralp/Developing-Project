@model TechStore.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "Ürün Ekle";
    Layout = "_AdminLayout";
}

<div class="product-create-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>

            <span class="form-page-kicker">
                PRODUCT MANAGEMENT
            </span>

            <h2>
                Add New Product
            </h2>

            <p>
                Create a new product and add it to your TechStore inventory.
            </p>

        </div>

        <a asp-action="Index" class="btn-secondary-custom">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Products

        </a>

    </div>

    <!-- FORM -->
    <form method="post" enctype="multipart/form-data" class="product-form">

        <div class="product-form-grid">

            <!-- LEFT COLUMN -->
            <div class="product-form-main">

                <div class="form-card">

                    <div class="form-card-header">

                        <div>

                            <span class="form-section-kicker">
                                PRODUCT INFORMATION
                            </span>

                            <h3>
                                Basic Details
                            </h3>

                        </div>

                        <div class="form-header-icon">
                            <i class="fa-solid fa-box"></i>
                        </div>

                    </div>

                    <div class="form-card-body">

                        <!-- PRODUCT NAME -->
                        <div class="form-group">

                            <label asp-for="Name" class="form-label-custom">
                                Product Name
                            </label>

                            <div class="input-wrapper">

                                <i class="fa-solid fa-tag input-icon"></i>

                                <input asp-for="Name" class="form-control-custom" placeholder="Enter product name..." />

                            </div>

                            <span asp-validation-for="Name" class="validation-message">
                            </span>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="form-group">

                            <label asp-for="Description" class="form-label-custom">
                                Description
                            </label>

                            <textarea asp-for="Description" class="form-control-custom textarea-custom" placeholder="Describe the product..."></textarea>

                            <span asp-validation-for="Description" class="validation-message">
                            </span>

                        </div>

                        <!-- PRICE + STOCK -->
                        <div class="form-row">

                            <div class="form-group">

                                <label asp-for="Price" class="form-label-custom">
                                    Price
                                </label>

                                <div class="input-wrapper">

                                    <span class="currency-symbol">
                                        ₺
                                    </span>

                                    <input asp-for="Price" class="form-control-custom price-input" type="number" step="0.01" min="0" placeholder="0.00" />

                                </div>

                                <span asp-validation-for="Price" class="validation-message"></span>

                            </div>

                            <div class="form-group">

                                <label asp-for="Stock" class="form-label-custom">
                                    Stock
                                </label>

                                <div class="input-wrapper">

                                    <i class="fa-solid fa-boxes-stacked input-icon"></i>

                                    <input asp-for="Stock" class="form-control-custom" type="number" min="0" placeholder="0" />

                                </div>

                                <span asp-validation-for="Stock" class="validation-message"></span>

                            </div>

                        </div>

                        <!-- BRAND + CATEGORY -->
                        <div class="form-row">

                            <div class="form-group">

                                <label asp-for="Brand" class="form-label-custom">
                                    Brand
                                </label>

                                <div class="input-wrapper">

                                    <i class="fa-solid fa-copyright input-icon"></i>

                                    <input asp-for="Brand" class="form-control-custom" placeholder="Enter brand..." />

                                </div>

                                <span asp-validation-for="Brand" class="validation-message"></span>

                            </div>

                            <div class="form-group">

                                <label asp-for="CategoryId" class="form-label-custom">
                                    Category
                                </label>

                                <div class="input-wrapper select-wrapper">

                                    <i class="fa-solid fa-layer-group input-icon"></i>

                                    <select asp-for="CategoryId" class="form-control-custom">

                                        <option value="">
                                            Select category
                                        </option>

                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.Id">
                                                @category.Name
                                            </option>
                                        }

                                    </select>

                                </div>

                                <span asp-validation-for="CategoryId" class="validation-message"></span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- RİGHT COLUMN -->
            <div class="product-form-side">

                <!-- IMAGE -->
                <div class="form-card">

                    <div class="form-card-header">

                        <div>

                            <span class="form-section-kicker">
                                PRODUCT MEDIA
                            </span>

                            <h3>
                                Product Image
                            </h3>

                        </div>

                        <div class="form-header-icon gold">
                            <i class="fa-solid fa-image"></i>
                        </div>

                    </div>

                    <div class="form-card-body">

                        <label class="image-upload-area">

                            <input asp-for="ImageFile" type="file" accept="image/*" id="productImageInput" />

                            <div class="upload-icon">

                                <i class="fa-solid fa-cloud-arrow-up"></i>

                            </div>

                            <strong>
                                Upload Product Image
                            </strong>

                            <span>
                                Click to browse or drag an image here
                            </span>

                            <small>
                                JPG, JPEG, PNG or WEBP
                            </small>

                        </label>

                    </div>

                </div>

                <!-- INFORMATION -->
                <div class="form-card form-info-card">

                    <div class="form-card-header">

                        <div>

                            <span class="form-section-kicker">
                                QUICK NOTE
                            </span>

                            <h3>
                                Product Guidelines
                            </h3>

                        </div>

                        <div class="form-header-icon green">
                            <i class="fa-solid fa-circle-info"></i>
                        </div>

                    </div>

                    <div class="form-card-body">

                        <ul class="form-guidelines">

                            <li>
                                <i class="fa-solid fa-check"></i>
                                Use a clear product name.
                            </li>

                            <li>
                                <i class="fa-solid fa-check"></i>
                                Set the correct category.
                            </li>

                            <li>
                                <i class="fa-solid fa-check"></i>
                                Enter the current stock quantity.
                            </li>

                            <li>
                                <i class="fa-solid fa-check"></i>
                                Use a high-quality product image.
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

        <!-- FORM ACTİONS -->
        <div class="form-actions">

            <a asp-action="Index" class="btn-secondary-custom">

                <i class="fa-solid fa-xmark"></i>

                Cancel

            </a>

            <button type="submit" class="btn-primary-custom">

                <i class="fa-solid fa-check"></i>

                Save Product

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
