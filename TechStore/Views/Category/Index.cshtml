@model List<TechStore.Models.Category>

@{
    ViewData["Title"] = "Categories";
    Layout = "_AdminLayout";
}

<div class="category-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div class="page-header-content">

            <span class="page-eyebrow">
                CATEGORY MANAGEMENT
            </span>

            <h1>
                Categories
            </h1>

            <p>
                Manage and organize the product categories in your store.
            </p>

        </div>

        <div class="page-header-actions">

            <div class="category-total-badge">

                <span>
                    TOTAL
                </span>

                <strong>
                    @Model.Count
                </strong>

                <small>
                    @(Model.Count == 1 ? "category" : "categories")
                </small>

            </div>

            <a asp-action="Create"
               class="btn-primary-custom">

                <i class="fa-solid fa-plus"></i>

                <span>
                    New Category
                </span>

            </a>

        </div>

    </div>


    <!-- =====================================================
         CATEGORY CARD
         ===================================================== -->

    <section class="category-card">

        <!-- CARD HEADER -->

        <div class="category-card-header">

            <div class="category-card-heading">

                <span class="section-kicker">
                    ORGANIZATION
                </span>

                <h2>
                    All Categories
                </h2>

                <p>
                    View, edit or remove your existing product categories.
                </p>

            </div>

            <div class="category-header-icon">

                <i class="fa-solid fa-layer-group"></i>

            </div>

        </div>


        @if (Model.Any())
        {
            <!-- =================================================
                 TABLE
                 ================================================= -->

            <div class="category-table-wrapper">

                <table class="category-table">

                    <thead>

                        <tr>

                            <th class="category-id-column">
                                ID
                            </th>

                            <th>
                                Category
                            </th>

                            <th class="category-status-column">
                                Type
                            </th>

                            <th class="category-action-column">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var category in Model)
                        {
                            <tr>

                                <!-- ID -->

                                <td class="category-id-column">

                                    <span class="category-id">
                                        #@category.Id
                                    </span>

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    <div class="category-info">

                                        <div class="category-icon">

                                            <i class="fa-solid fa-layer-group"></i>

                                        </div>

                                        <div class="category-details">

                                            <strong>
                                                @category.Name
                                            </strong>

                                            <span>
                                                Product category
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- TYPE -->

                                <td class="category-status-column">

                                    <span class="category-type-badge">

                                        <span class="type-dot"></span>

                                        ACTIVE CATEGORY

                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td class="category-action-column">

                                    <div class="category-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="category-action-btn category-edit"
                                           title="Edit category"
                                           aria-label="Edit @category.Name">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@category.Id"
                                           class="category-action-btn category-delete"
                                           title="Delete category"
                                           aria-label="Delete @category.Name">

                                            <i class="fa-solid fa-trash-can"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- TABLE FOOTER -->

            <div class="category-card-footer">

                <div class="category-footer-info">

                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Showing @Model.Count
                        @(Model.Count == 1 ? "category" : "categories")
                    </span>

                </div>

                <div class="category-footer-status">

                    <span class="status-indicator"></span>

                    <span>
                        CATEGORY SYSTEM ONLINE
                    </span>

                </div>

            </div>
        }
        else
        {
            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            <div class="category-empty">

                <div class="category-empty-icon">

                    <i class="fa-solid fa-folder-open"></i>

                </div>

                <span class="empty-kicker">
                    ORGANIZATION EMPTY
                </span>

                <strong>
                    No categories yet
                </strong>

                <p>
                    Create your first product category to start
                    organizing your store.
                </p>

                <a asp-action="Create"
                   class="btn-primary-custom">

                    <i class="fa-solid fa-plus"></i>

                    <span>
                        Create Category
                    </span>

                </a>

            </div>
        }

    </section>

</div>