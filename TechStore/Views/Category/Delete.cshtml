@model TechStore.Models.Category
@{
    ViewData["Title"] = "Kategori Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="category-delete-page">

    <div class="page-header">
        <span class="page-eyebrow">KATEGORİ YÖNETİMİ</span>
        <h2>Kategori Sil</h2>
    </div>

    <div class="delete-card">

        <div class="delete-warning">

            <div class="delete-warning-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="confirmation-content">
                <strong>Bu işlem geri alınamaz</strong>
                <p>Kategoriyi sildiğinde, bu kategoriye bağlı ürünler etkilenebilir.</p>
            </div>

        </div>

        <div class="delete-confirmation">
            <strong>@Model.Name</strong> kategorisini silmek istediğinize emin misiniz?
        </div>

        <form method="post" class="delete-actions">

            <input type="hidden" asp-for="Id" />

            <a asp-action="Index" class="btn-secondary-custom">
                <i class="fa-solid fa-xmark"></i>
                Vazgeç
            </a>

            <button type="submit" class="btn-delete-confirm">
                <i class="fa-solid fa-trash-can"></i>
                Evet, Sil
            </button>

        </form>

    </div>

</div>
