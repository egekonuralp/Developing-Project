@model TechStore.Models.Category

@{
    ViewData["Title"] = "Kategori Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="category-form-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div class="page-header-content">

            <span class="page-eyebrow">
                CATEGORY MANAGEMENT
            </span>

            <h1>
                Kategori Ekle
            </h1>

            <p>
                Ürünleri düzenlemek için yeni bir kategori oluşturun.
            </p>

        </div>

        <div class="page-header-actions">

            <a asp-action="Index"
               class="btn-secondary-custom">

                <i class="fa-solid fa-arrow-left"></i>

                <span>
                    Kategorilere Dön
                </span>

            </a>

        </div>

    </div>


    <!-- =====================================================
         CREATE FORM
         ===================================================== -->

    <form method="post"
          class="category-form">

        @Html.AntiForgeryToken()


        <!-- =================================================
             CATEGORY INFORMATION
             ================================================= -->

        <section class="form-card">

            <div class="form-card-header">

                <div class="form-card-heading">

                    <span class="form-section-kicker">
                        NEW CATEGORY
                    </span>

                    <h2>
                        Kategori Bilgileri
                    </h2>

                    <p>
                        Oluşturmak istediğiniz kategorinin adını girin.
                    </p>

                </div>

                <div class="form-header-icon">

                    <i class="fa-solid fa-folder-plus"></i>

                </div>

            </div>


            <!-- =================================================
                 FORM BODY
                 ================================================= -->

            <div class="form-card-body">

                <div class="form-group">

                    <label asp-for="Name"
                           class="form-label-custom">
                        Kategori Adı
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            <i class="fa-solid fa-tag"></i>
                        </span>

                        <input asp-for="Name"
                               class="form-control-custom"
                               placeholder="Örn. Dizüstü Bilgisayarlar" />

                    </div>

                    <span asp-validation-for="Name"
                          class="validation-message">
                    </span>

                    <small class="field-help">
                        Kategori adı ürün listeleme ve filtreleme alanlarında
                        görüntülenecektir.
                    </small>

                </div>

            </div>

        </section>


        <!-- =================================================
             FORM ACTIONS
             ================================================= -->

        <div class="form-actions">

            <a asp-action="Index"
               class="btn-secondary-custom">

                <i class="fa-solid fa-xmark"></i>

                <span>
                    İptal
                </span>

            </a>


            <button type="submit"
                    class="btn-primary-custom">

                <i class="fa-solid fa-plus"></i>

                <span>
                    Kategori Oluştur
                </span>

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}