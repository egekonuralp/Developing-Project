@model TechStore.ViewModels.CheckoutViewModel

<div class="checkout-page">

    <!-- HEADER -->
    <div class="checkout-header">

        <div>

            <span class="checkout-label">
                SİPARİŞ OLUŞTUR
            </span>

            <h1>
                Siparişi Tamamla
            </h1>

            <p>
                Teslimat bilgilerinizi girerek siparişinizi oluşturabilirsiniz.
            </p>

        </div>

        <a asp-controller="Cart" asp-action="Index" class="checkout-back-button">
            ← Sepete Dön
        </a>

    </div>

    <form asp-action="Checkout" method="post">

        <div asp-validation-summary="ModelOnly" class="checkout-validation"></div>

        <div class="checkout-content">

            <!-- LEFT SİDE -->
            <div class="checkout-form">

                <div class="checkout-card-header">

                    <div>

                        <span class="checkout-section-label">
                            TESLİMAT
                        </span>

                        <h2>
                            Teslimat Bilgileri
                        </h2>

                    </div>

                    <span class="checkout-step">
                        01
                    </span>

                </div>

                <div class="checkout-form-body">

                    <!-- AD SOYAD -->
                    <div class="form-group">

                        <label asp-for="FullName">
                            Ad Soyad
                        </label>

                        <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Adınız ve soyadınız" />
                        
                        <span asp-validation-for="FullName" class="text-danger"></span>

                    </div>

                    <!-- TELEFON -->
                    <div class="form-group">

                        <label asp-for="PhoneNumber">
                            Telefon
                        </label>

                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="05XX XXX XX XX" />

                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                    </div>

                    <!-- CITY / DISTRICT -->
                    <div class="checkout-form-row">

                        <div class="form-group">

                            <label asp-for="City">
                                Şehir
                            </label>

                            <input asp-for="City" class="form-control" autocomplete="address-level1" placeholder="Şehir" />

                            <span asp-validation-for="City" class="text-danger"></span>

                        </div>

                        <div class="form-group">

                            <label asp-for="District">
                                İlçe
                            </label>

                            <input asp-for="District" class="form-control" autocomplete="address-level2" placeholder="İlçe" />

                            <span asp-validation-for="District" class="text-danger"></span>

                        </div>

                    </div>

                    <!-- ADRES -->
                    <div class="form-group">

                        <label asp-for="Address">
                            Açık Adres
                        </label>

                        <textarea asp-for="Address" rows="5" class="form-control" autocomplete="street-address" placeholder="Mahalle, sokak, bina no, daire no vb."></textarea>

                        <span asp-validation-for="Address" class="text-danger"></span>

                    </div>

                    <div class="checkout-notice">

                        <span class="checkout-notice-icon">
                            ℹ
                        </span>

                        <p>
                            Siparişiniz bu adrese teslim edilmek üzere oluşturulacaktır.
                            Lütfen bilgilerin doğru olduğundan emin olun.
                        </p>

                    </div>

                </div>

            </div>

            <!-- RİGHT SİDE -->
            <div class="checkout-summary">

                <div class="checkout-card-header">

                    <div>

                        <span class="checkout-section-label">
                            ÖZET
                        </span>

                        <h2>
                            Sipariş Özeti
                        </h2>

                    </div>

                    <span class="checkout-step">
                        02
                    </span>

                </div>

                <div class="checkout-summary-body">

                    <!-- TOTAL QUANTITY -->
                    <div class="summary-row">

                        <span>
                            Toplam Ürün
                        </span>

                        <strong>
                            @Model.TotalQuantity
                        </strong>

                    </div>

                    <!-- TOTAL PRICE -->
                    <div class="summary-row">

                        <span>
                            Genel Toplam
                        </span>

                        <strong class="checkout-total">
                            @Model.TotalPrice.ToString("N2") ₺
                        </strong>

                    </div>

                    <!-- DIVIDER -->
                    <div class="checkout-summary-divider"></div>

                    <!-- INFO -->
                    <div class="checkout-summary-info">

                        <span class="summary-info-icon">
                            ✓
                        </span>

                        <div>

                            <strong>
                                Sipariş Bilgileri
                            </strong>

                            <p>
                                Siparişinizi onayladıktan sonra
                                sipariş detaylarınızı hesabınızdan takip edebilirsiniz.
                            </p>

                        </div>

                    </div>

                    <!-- SUBMIT -->
                    <button type="submit" class="tech-btn tech-btn-primary checkout-submit">
                        Siparişi Onayla
                    </button>

                    <!-- BACK TO CART -->
                    <a asp-controller="Cart" asp-action="Index" class="checkout-cart-link">
                        ← Sepeti Düzenle
                    </a>

                </div>

            </div>

        </div>

    </form>

</div>