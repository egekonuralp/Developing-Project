@model TechStore.ViewModels.MyOrdersListViewModel

@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="orders-page">

    <div class="orders-container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="orders-header">

            <div class="orders-header-main">

                <div class="orders-icon" aria-hidden="true">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <div>

                    <span class="orders-eyebrow">
                        HESABIM / SİPARİŞLER
                    </span>

                    <h1>
                        Siparişlerim
                    </h1>

                    <p>
                        Geçmiş ve mevcut siparişlerinizi buradan takip edebilirsiniz.
                    </p>

                </div>

            </div>

            @if (Model.Orders.Any())
            {
                <div class="orders-count">

                    <span class="orders-count-label">
                        TOPLAM
                    </span>

                    <strong>
                        @Model.Orders.Count
                    </strong>

                    <span class="orders-count-text">
                        sipariş
                    </span>

                </div>
            }

        </div>


        @if (!Model.Orders.Any())
        {
            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            <section class="orders-empty">

                <div class="orders-empty-icon">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <span class="orders-empty-eyebrow">
                    HENÜZ SİPARİŞ YOK
                </span>

                <h2>
                    Henüz siparişiniz bulunmuyor.
                </h2>

                <p>
                    İlk siparişinizi oluşturmak için ürünlerimizi inceleyerek
                    alışverişe başlayabilirsiniz.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="orders-shopping-button">

                    <span>
                        Alışverişe Başla
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </section>
        }
        else
        {
            <!-- =================================================
                 ORDERS GRID
                 ================================================= -->

            <section class="orders-list"
                     aria-label="Siparişleriniz">

                @foreach (var order in Model.Orders)
                {
                    var statusClass = order.Status switch
                    {
                        OrderStatuses.Preparing => "status-preparing",
                        OrderStatuses.Shipped => "status-shipped",
                        OrderStatuses.Delivered => "status-delivered",
                        OrderStatuses.Cancelled => "status-cancelled",
                        _ => "status-default"
                    };

                    var statusIcon = order.Status switch
                    {
                        OrderStatuses.Preparing => "fa-solid fa-box",
                        OrderStatuses.Shipped => "fa-solid fa-truck",
                        OrderStatuses.Delivered => "fa-solid fa-circle-check",
                        OrderStatuses.Cancelled => "fa-solid fa-circle-xmark",
                        _ => "fa-solid fa-circle-info"
                    };

                    <article class="order-card">

                        <!-- CARD TOP -->

                        <div class="order-card-top">

                            <div class="order-card-identity">

                                <span class="order-card-label">
                                    SİPARİŞ
                                </span>

                                <strong class="order-number">
                                    #@order.OrderId
                                </strong>

                            </div>

                            <div class="order-card-date">

                                <span class="order-card-label">
                                    TARİH
                                </span>

                                <strong>
                                    @order.OrderDate.ToString("dd.MM.yyyy")
                                </strong>

                            </div>

                        </div>


                        <!-- STATUS -->

                        <div class="order-card-status @statusClass">

                            <i class="@statusIcon"></i>

                            <span>
                                @order.Status
                            </span>

                        </div>


                        <!-- CARD BODY -->

                        <div class="order-card-body">

                            <div class="order-total-block">

                                <span>
                                    TOPLAM TUTAR
                                </span>

                                <strong>
                                    @order.TotalPrice.ToString("N2") ₺
                                </strong>

                            </div>

                            <div class="order-card-meta">

                                <div class="meta-line">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span>
                                        @order.OrderDate.ToString("dd MMMM yyyy")
                                    </span>
                                </div>

                                <div class="meta-line">
                                    <i class="fa-solid fa-receipt"></i>
                                    <span>
                                        Sipariş #@order.OrderId
                                    </span>
                                </div>

                            </div>

                        </div>


                        <!-- CARD FOOTER -->

                        <div class="order-card-footer">

                            <span class="order-footer-text">
                                Sipariş bilgilerini ve teslimat durumunu görüntüle
                            </span>

                            <a asp-action="Detail"
                               asp-route-id="@order.OrderId"
                               class="order-detail-button">

                                <span>
                                    Sipariş Detayı
                                </span>

                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>

                    </article>
                }

            </section>
        }

    </div>

</div>