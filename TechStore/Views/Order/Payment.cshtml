@model TechStore.ViewModels.PaymentViewModel

<div class="payment-page">

    <div class="payment-card">

        <!-- HEADER -->
        <div class="payment-header">

            <div class="payment-header-icon">
                💳
            </div>

            <div>

                <h1>Ödeme</h1>

                <p>
                    Siparişinizi tamamlamak için ödeme bilgilerinizi giriniz.
                </p>

            </div>

        </div>

        <form asp-action="Payment" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="payment-content">

                <!-- SOL TARAF -->
                <div class="payment-form">

                    <div class="section-title">

                        <span class="section-icon">
                            💳
                        </span>

                        <h2>Ödeme Bilgileri</h2>

                    </div>

                    <!-- CARD HOLDER -->
                    <div class="form-group">

                        <label asp-for="CardHolderName">
                            Kart Üzerindeki İsim
                        </label>

                        <input asp-for="CardHolderName" class="form-control" placeholder="Ad Soyad" autocomplete="cc-name" />

                        <span asp-validation-for="CardHolderName" class="text-danger"></span>

                    </div>

                    <!-- CARD NUMBER -->
                    <div class="form-group">

                        <label asp-for="CardNumber">
                            Kart Numarası
                        </label>

                        <input asp-for="CardNumber" class="form-control" placeholder="1234 5678 1234 5678" maxlength="19" autocomplete="cc-number" />

                        <span asp-validation-for="CardNumber" class="text-danger"></span>

                    </div>

                    <!-- EXPIRATION + CVV -->
                    <div class="payment-row">

                        <div class="form-group">

                            <label asp-for="ExpirationDate">
                                Son Kullanma Tarihi
                            </label>

                            <input asp-for="ExpirationDate" class="form-control" placeholder="MM/YY" maxlength="5" autocomplete="cc-exp" />

                            <span asp-validation-for="ExpirationDate" class="text-danger"></span>

                        </div>

                        <div class="form-group">

                            <label asp-for="CVV">
                                CVV
                            </label>

                            <input asp-for="CVV" class="form-control" placeholder="123" maxlength="4" autocomplete="cc-csc" />

                            <span asp-validation-for="CVV" class="text-danger"></span>

                        </div>

                    </div>

                    <!-- SECURITY -->
                    <div class="payment-security">

                        <span class="payment-security-icon">
                            🔒
                        </span>

                        <div>

                            <strong>
                                Güvenli Ödeme
                            </strong>

                            <p>
                                Kart bilgileriniz güvenli bir şekilde işlenir.
                            </p>

                        </div>

                    </div>

                    <hr />

                    <!-- DELIVERY -->
                    <div class="section-title">

                        <span class="section-icon">
                            📦
                        </span>

                        <h2>Teslimat Bilgileri</h2>

                    </div>

                    <div class="delivery-summary">

                        <div class="delivery-row">

                            <span>Ad Soyad</span>

                            <strong>
                                @Model.FullName
                            </strong>

                        </div>

                        <div class="delivery-row">

                            <span>Telefon</span>

                            <strong>
                                @Model.PhoneNumber
                            </strong>

                        </div>

                        <div class="delivery-row">

                            <span>Konum</span>

                            <strong>
                                @Model.City / @Model.District
                            </strong>

                        </div>

                        <div class="delivery-row">

                            <span>Teslimat Adresi</span>

                            <strong>
                                @Model.Address
                            </strong>

                        </div>

                    </div>

                </div>

                <!-- SAĞ TARAF -->
                <aside class="payment-summary">

                    <div class="summary-header">

                        <span class="summary-icon">
                            🛒
                        </span>

                        <h2>Sipariş Özeti</h2>

                    </div>

                    <div class="summary-row">

                        <span>Toplam Ürün</span>

                        <strong>
                            @Model.TotalQuantity
                        </strong>

                    </div>

                    <div class="summary-row">

                        <span>Ürün Çeşidi</span>

                        <strong>
                            @Model.Cart.CartItems.Count
                        </strong>

                    </div>

                    <div class="summary-total">

                        <span>Genel Toplam</span>

                        <strong>
                            @Model.TotalPrice.ToString("N2") ₺
                        </strong>

                    </div>

                    <div class="summary-buttons">

                        <a asp-controller="Cart" asp-action="Index" class="tech-btn tech-btn-outline">
                            Sepete Dön
                        </a>

                        <button type="submit" class="tech-btn tech-btn-primary">
                            🔒 Ödemeyi Tamamla
                        </button>

                    </div>

                    <div class="payment-note">

                        <span>✓</span>

                        <p>
                            Siparişinizi onayladıktan sonra ödeme işleminiz tamamlanacaktır.
                        </p>

                    </div>

                </aside>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
