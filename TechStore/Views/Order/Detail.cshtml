@model TechStore.ViewModels.OrderDetailViewModel

<div class="order-detail-page">

    <!-- HEADER -->
    <div class="order-detail-header">

        <div>

            <span class="order-detail-label">
                SİPARİŞ DETAYI
            </span>

            <h1>
                Sipariş #@Model.OrderId
            </h1>

            <p>
                Siparişinizin detaylarını ve teslimat bilgilerini aşağıda görebilirsiniz.
            </p>

        </div>

        <a asp-action="MyOrders" class="order-back-button">
            ← Siparişlerime Dön
        </a>

    </div>

    <!-- ORDER SUMMARY -->
    <div class="order-summary-card">

        <div class="order-info-item">

            <span class="order-info-label">
                Sipariş No
            </span>

            <strong>
                #@Model.OrderId
            </strong>

        </div>

        <div class="order-info-item">

            <span class="order-info-label">
                Sipariş Tarihi
            </span>

            <strong>
                @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
            </strong>

        </div>

        <div class="order-info-item">

            <span class="order-info-label">
                Durum
            </span>

            <strong class="order-status">
                @Model.Status
            </strong>

        </div>

        <div class="order-info-item order-total">

            <span class="order-info-label">
                Toplam
            </span>

            <strong>
                @Model.TotalPrice.ToString("N2") ₺
            </strong>

        </div>

    </div>

    <!-- ORDER TRACKİNG -->
    <div class="order-tracking-card">

        <div class="order-card-header">

            <h2> Sipariş Takibi </h2>

        </div>

        @{
            var isPreparing = Model.Status == OrderStatuses.Preparing;
            var isShipped = Model.Status == OrderStatuses.Shipped;
            var isDelivered = Model.Status == OrderStatuses.Delivered;

            var preparingCompleted = isShipped || isDelivered;
            var shippedCompleted = isDelivered;
        }

        <div class="order-tracking">

            <!-- PREPARING -->
            <div class="tracking-step @(isPreparing ? "active" : "") @(preparingCompleted ? "completed" : "")">

                <div class="tracking-icon">
                    @if (preparingCompleted)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-box"></i>
                    }
                </div>

                <div class="tracking-content">

                    <strong> Sipariş Hazırlanıyor </strong>

                    <span> Siparişiniz hazırlanıyor. </span>

                </div>

            </div>

            <div class="tracking-line @(preparingCompleted ? "completed" : "")"></div>

            <!-- SHIPPED -->
            <div class="tracking-step @(isShipped ? "active" : "") @(shippedCompleted ? "completed" : "")">

                <div class="tracking-icon">
                    @if (shippedCompleted)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-truck"></i>
                    }
                </div>

                <div class="tracking-content">

                    <strong> Kargoya Verildi </strong>

                    <span> Siparişiniz kargoya teslim edildi. </span>

                </div>

            </div>

            <div class="tracking-line @(shippedCompleted ? "completed" : "")"></div>

            <!-- DELIVERED -->
            <div class="tracking-step @(isDelivered ? "active completed" : "")">

                <div class="tracking-icon">
                    @if (isDelivered)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-house-circle-check"></i>
                    }
                </div>

                <div class="tracking-content">

                    <strong> Teslim Edildi </strong>

                    <span> Siparişiniz teslim edildi. </span>

                </div>

            </div>

        </div>

    </div>

    <!-- MAIN CONTENT -->
    <div class="order-detail-content">

        <!-- PRODUCTS -->
        <div class="order-products-card">

            <div class="order-card-header">

                <h2>
                    Sipariş Ürünleri
                </h2>

                <span>
                    @Model.OrderItems.Count Ürün
                </span>

            </div>

            <div class="order-products-table-wrapper">

                <table class="order-products-table">

                    <thead>

                        <tr>

                            <th>
                                Ürün
                            </th>

                            <th>
                                Birim Fiyat
                            </th>

                            <th>
                                Adet
                            </th>

                            <th>
                                Toplam
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>

                                <td>

                                    <div class="order-product-name">

                                        <span class="product-icon">
                                            ▪
                                        </span>

                                        <strong>
                                            @item.ProductName
                                        </strong>

                                    </div>

                                </td>

                                <td>
                                    @item.UnitPrice.ToString("N2") ₺
                                </td>

                                <td>

                                    <span class="quantity-badge">
                                        @item.Quantity
                                    </span>

                                </td>

                                <td class="product-total">
                                    @item.TotalPrice.ToString("N2") ₺
                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

            <!-- ORDERS TOTAL -->
            <div class="order-products-total">

                <div class="order-total-row">

                    <span>
                        Ürünler Toplamı
                    </span>

                    <strong>
                        @Model.Subtotal.ToString("N2") ₺
                    </strong>

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CouponCode) && Model.DiscountAmount > 0)
            {
                <div class="order-total-row order-discount-row">

                    <span>
                        Kupon İndirimi
                    </span>

                    <strong>
                        -@Model.DiscountAmount.ToString("N2") ₺
                    </strong>

                </div>

                <div class="order-total-row order-coupon-row">

                    <span>
                        Kullanılan Kupon
                    </span>

                    <strong>
                        @Model.CouponCode
                    </strong>

                </div>
            }

            <div class="order-total-divider"></div>

            <div class="order-total-row order-final-total">

                <span>
                    Genel Toplam
                </span>

                <strong>
                    @Model.TotalPrice.ToString("N2") ₺
                </strong>

            </div>

            <!-- DELIVERY -->
            <div class="delivery-card">

                <div class="order-card-header">

                    <h2>
                        Teslimat Bilgileri
                    </h2>

                </div>

                <div class="delivery-content">

                    <div class="delivery-row">

                        <span class="delivery-label">
                            Ad Soyad
                        </span>

                        <strong>
                            @Model.FullName
                        </strong>

                    </div>

                    <div class="delivery-row">

                        <span class="delivery-label">
                            Telefon
                        </span>

                        <strong>
                            @Model.Phone
                        </strong>

                    </div>

                    <div class="delivery-row">

                        <span class="delivery-label">
                            Şehir
                        </span>

                        <strong>
                            @Model.City
                        </strong>

                    </div>

                    <div class="delivery-row">

                        <span class="delivery-label">
                            İlçe
                        </span>

                        <strong>
                            @Model.District
                        </strong>

                    </div>

                    <div class="delivery-address">

                        <span class="delivery-label">
                            Adres
                        </span>

                        <p>
                            @Model.Address
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <!-- FOOTER ACTION -->
        <div class="order-detail-footer">

            <a asp-action="MyOrders" class="order-back-button">
                ← Siparişlerime Dön
            </a>

        </div>

    </div>

</div>