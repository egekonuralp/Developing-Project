@model TechStore.ViewModels.OrderDetailViewModel
@using TechStore.Models

@{
    ViewData["Title"] = $"Sipariş #{Model.OrderId}";

    var statusClass = Model.Status switch
    {
        OrderStatuses.Preparing => "status-preparing",
        OrderStatuses.Shipped => "status-shipped",
        OrderStatuses.Delivered => "status-delivered",
        OrderStatuses.Cancelled => "status-cancelled",
        _ => "status-default"
    };

    var statusIcon = Model.Status switch
    {
        OrderStatuses.Preparing => "fa-solid fa-box",
        OrderStatuses.Shipped => "fa-solid fa-truck",
        OrderStatuses.Delivered => "fa-solid fa-circle-check",
        OrderStatuses.Cancelled => "fa-solid fa-circle-xmark",
        _ => "fa-solid fa-circle-info"
    };

    var isPreparing = Model.Status == OrderStatuses.Preparing;
    var isShipped = Model.Status == OrderStatuses.Shipped;
    var isDelivered = Model.Status == OrderStatuses.Delivered;

    var preparingCompleted = isShipped || isDelivered;
    var shippedCompleted = isDelivered;
}

<div class="order-detail-page">

    <div class="order-detail-container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="order-detail-header">

            <div class="order-detail-header-main">

                <a asp-action="MyOrders" class="order-back-button order-back-button-icon" aria-label="Siparişlerime dön">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>

                <div>

                    <span class="order-detail-eyebrow">
                        HESABIM / SİPARİŞLER / #@Model.OrderId
                    </span>

                    <h1>
                        Sipariş #@Model.OrderId
                    </h1>

                    <p>
                        Siparişinizin detaylarını ve teslimat bilgilerini aşağıda görebilirsiniz.
                    </p>

                </div>

            </div>

            <div class="order-detail-status @statusClass">
                <i class="@statusIcon"></i>
                <span>@Model.Status</span>
            </div>

        </div>

        <!-- =====================================================
             ORDER SUMMARY
             ===================================================== -->

        <div class="order-summary-card">

            <div class="order-info-item">

                <span class="order-info-label">
                    <i class="fa-solid fa-hashtag"></i>
                    Sipariş No
                </span>

                <strong>
                    #@Model.OrderId
                </strong>

            </div>

            <div class="order-info-item">

                <span class="order-info-label">
                    <i class="fa-regular fa-calendar"></i>
                    Sipariş Tarihi
                </span>

                <strong>
                    @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
                </strong>

            </div>

            <div class="order-info-item">

                <span class="order-info-label">
                    <i class="fa-regular fa-box"></i>
                    Ürün
                </span>

                <strong>
                    @Model.OrderItems.Count adet
                </strong>

            </div>

            <div class="order-info-item order-total">

                <span class="order-info-label">
                    <i class="fa-solid fa-sack-dollar"></i>
                    Toplam
                </span>

                <strong>
                    @Model.TotalPrice.ToString("N2") ₺
                </strong>

            </div>

        </div>

        <!-- =====================================================
             ORDER TRACKING
             ===================================================== -->

        <div class="order-tracking-card">

            <div class="order-card-header">
                <h2>Sipariş Takibi</h2>
            </div>

            <div class="order-tracking">

                <!-- PREPARING -->
                <div class="tracking-step @(isPreparing ? "active" : "") @(preparingCompleted ? "completed" : "")">

                    <div class="tracking-icon">
                        @if (preparingCompleted)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-box"></i>
                        }
                    </div>

                    <div class="tracking-content">
                        <strong>Sipariş Hazırlanıyor</strong>
                        <span>Siparişiniz hazırlanıyor.</span>
                    </div>

                </div>

                <div class="tracking-line @(preparingCompleted ? "completed" : "")"></div>

                <!-- SHIPPED -->
                <div class="tracking-step @(isShipped ? "active" : "") @(shippedCompleted ? "completed" : "")">

                    <div class="tracking-icon">
                        @if (shippedCompleted)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-truck"></i>
                        }
                    </div>

                    <div class="tracking-content">
                        <strong>Kargoya Verildi</strong>
                        <span>Siparişiniz kargoya teslim edildi.</span>
                    </div>

                </div>

                <div class="tracking-line @(shippedCompleted ? "completed" : "")"></div>

                <!-- DELIVERED -->
                <div class="tracking-step @(isDelivered ? "active completed" : "")">

                    <div class="tracking-icon">
                        @if (isDelivered)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-house-circle-check"></i>
                        }
                    </div>

                    <div class="tracking-content">
                        <strong>Teslim Edildi</strong>
                        <span>Siparişiniz teslim edildi.</span>
                    </div>

                </div>

            </div>

        </div>

        <!-- =====================================================
             MAIN CONTENT — products (left) + delivery (right sidebar)
             ===================================================== -->

        <div class="order-detail-content">

            <!-- PRODUCTS -->
            <div class="order-products-card">

                <div class="order-card-header">

                    <h2>Sipariş Ürünleri</h2>

                    <span>@Model.OrderItems.Count Ürün</span>

                </div>

                <div class="order-products-table-wrapper">

                    <table class="order-products-table">

                        <thead>

                            <tr>
                                <th>Ürün</th>
                                <th>Birim Fiyat</th>
                                <th>Adet</th>
                                <th>Toplam</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>

                                    <td>
                                        <div class="order-product-name">
                                            <span class="product-icon">⌁</span>
                                            <strong>@item.ProductName</strong>
                                        </div>
                                    </td>

                                    <td>@item.UnitPrice.ToString("N2") ₺</td>

                                    <td>
                                        <span class="quantity-badge">@item.Quantity</span>
                                    </td>

                                    <td class="product-total">@item.TotalPrice.ToString("N2") ₺</td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- TOTALS -->
                <div class="order-products-total">

                    <div class="order-total-row">
                        <span>Ürünler Toplamı</span>
                        <strong>@Model.Subtotal.ToString("N2") ₺</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CouponCode) && Model.DiscountAmount > 0)
                    {
                        <div class="order-total-row order-discount-row">
                            <span>Kupon İndirimi</span>
                            <strong>-@Model.DiscountAmount.ToString("N2") ₺</strong>
                        </div>

                        <div class="order-total-row order-coupon-row">
                            <span>Kullanılan Kupon</span>
                            <strong>@Model.CouponCode</strong>
                        </div>
                    }

                    <div class="order-total-divider"></div>

                    <div class="order-total-row order-final-total">
                        <span>Genel Toplam</span>
                        <strong>@Model.TotalPrice.ToString("N2") ₺</strong>
                    </div>

                </div>

            </div>

            <!-- DELIVERY -->
            <aside class="delivery-card">

                <div class="order-card-header">
                    <h2>Teslimat Bilgileri</h2>
                </div>

                <div class="delivery-content">

                    <div class="delivery-row">
                        <span class="delivery-label"><i class="fa-regular fa-user"></i> Ad Soyad</span>
                        <strong>@Model.FullName</strong>
                    </div>

                    <div class="delivery-row">
                        <span class="delivery-label"><i class="fa-solid fa-phone"></i> Telefon</span>
                        <strong>@Model.Phone</strong>
                    </div>

                    <div class="delivery-row">
                        <span class="delivery-label"><i class="fa-solid fa-city"></i> Şehir</span>
                        <strong>@Model.City</strong>
                    </div>

                    <div class="delivery-row">
                        <span class="delivery-label"><i class="fa-solid fa-map-pin"></i> İlçe</span>
                        <strong>@Model.District</strong>
                    </div>

                    <div class="delivery-address">
                        <span class="delivery-label"><i class="fa-solid fa-location-dot"></i> Adres</span>
                        <p>@Model.Address</p>
                    </div>

                </div>

            </aside>

        </div>

        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <div class="order-detail-footer">

            <a asp-action="MyOrders" class="order-back-button">
                <i class="fa-solid fa-arrow-left"></i>
                Siparişlerime Dön
            </a>

        </div>

    </div>

</div>
